model DiseaseGuide {
  id        String  @id @default(uuid()) @db.Uuid
  diseaseId String  @db.Uuid
  title     String
  content   String  @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([diseaseId])
  @@map("disease_guides")
}

model Course {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  description String? @db.Text
  status      ContentStatus @default(DRAFT)

  learningProgress LearningProgress[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("courses")
}

model Bookmark {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  articleId String? @db.Uuid

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
  @@map("bookmarks")
}

model LearningProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  progressPct Float  @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@map("learning_progress")
}

// ============================================================
// MARKETPLACE DOMAIN — Sec. 42
// Owner: Marketplace Module. Independent of other domains (Sec. 46).
// Responsibilities: Shopping, Nearby Stores, Affiliate Revenue
// ============================================================

model StoreCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  stores Store[]

  createdAt DateTime @default(now())

  @@map("store_categories")
}

model Store {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String  @db.Uuid
  name       String
  latitude   Float?
  longitude  Float?
  cityId     String? @db.Uuid

  category StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city     City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  products StoreProduct[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([cityId])
  @@map("stores")
}

model StoreProduct {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  name    String
  price   Float?
  currency String @default("USD")
  inStock Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shoppingItems ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("store_products")
}

model ShoppingList {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  name   String  @default("My Shopping List")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("shopping_lists")
}

model ShoppingItem {
  id             String   @id @default(uuid()) @db.Uuid
  shoppingListId String   @db.Uuid
  foodId         String?  @db.Uuid
  storeProductId String?  @db.Uuid
  name           String
  quantity       Float?
  unit           String?
  purchased      Boolean  @default(false)

  shoppingList ShoppingList  @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shoppingListId])
  @@map("shopping_items")
}

model AffiliatePartner {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  website String?
  commissionPct Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("affiliate_partners")
}

model HealthyRestaurant {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  cityId    String? @db.Uuid
  latitude  Float?
  longitude Float?

  city  City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  menus RestaurantMenu[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([cityId])
  @@map("healthy_restaurants")
}

model RestaurantMenu {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @db.Uuid
  itemName     String
  caloriesKcal Float?
  price        Float?

  restaurant HealthyRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("restaurant_menus")
}

model OrderHistory {
  id       String      @id @default(uuid()) @db.Uuid
  userId   String      @db.Uuid
  status   OrderStatus @default(PENDING)
  totalAmount Float?
  currency String      @default("USD")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("order_history")
}

// ============================================================
// AI DOMAIN — Sec. 43
// Owner: AI Module
// Responsibilities: Chat, Knowledge Base, Prompt Management, AI Analytics
// Sec. Security — never expose prompts or internal AI logic through this schema's
// application-layer read paths; PromptTemplate content is service-internal only.
// ============================================================

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String?
  isActive  Boolean  @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  role           ConversationRole
  content        String            @db.Text
  // Formatter output only — raw LLM output must never be persisted/returned directly (AI RULES)
  passedSafetyEngine Boolean        @default(false)
  passedRuleEngine   Boolean        @default(false)
  passedValidation   Boolean        @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Sec. Security — "Never hardcode prompts" — templates are versioned and DB-managed, never inline in code
model PromptTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique
  category    PromptTemplateCategory
  version     Int                     @default(1)
  templateBody String                 @db.Text
  variables   Json? // documents expected interpolation variables
  isActive    Boolean                 @default(true)

  promptHistory PromptHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid

  @@index([category])
  @@index([name, version])
  @@map("prompt_templates")
}

// History Table — every prompt template change is versioned, never overwritten silently
model PromptHistory {
  id               String   @id @default(uuid()) @db.Uuid
  promptTemplateId String   @db.Uuid
  previousBody     String   @db.Text
  changedBy        String?  @db.Uuid
  changeReason     String?

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([promptTemplateId])
  @@map("prompt_history")
}

// RAG knowledge base — Sec. AI RESPONSIBILITIES: Knowledge Base, RAG
model KnowledgeArticle {
  id        String  @id @default(uuid()) @db.Uuid
  title     String
  content   String  @db.Text
  sourceType String // medical_guideline | nutrition_science | internal_policy
  sourceRef String?
  isActive  Boolean @default(true)

  embeddings Embedding[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sourceType])
  @@map("knowledge_articles")
}

// Vector Database Integration — Sec. AI TECH STACK. The actual vector lives in the
// Vector DB (VECTOR_DB_URL); this table stores the pointer + metadata for traceability.
model Embedding {
  id                 String  @id @default(uuid()) @db.Uuid
  knowledgeArticleId String  @db.Uuid
  vectorStoreId      String // id/key of the vector in the external vector database
  model              String // embedding model identifier, e.g. "text-embedding-3-large"
  dimensions         Int
  chunkIndex         Int    @default(0)
  chunkText          String @db.Text

  knowledgeArticle KnowledgeArticle @relation(fields: [knowledgeArticleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([knowledgeArticleId])
  @@index([vectorStoreId])
  @@map("embeddings")
}

model AIFeedback {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  messageId String?      @db.Uuid
  feedback  FeedbackType
  comment   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ai_feedback")
}

// AI Analytics — every AI decision is logged for audit/explainability, never raw LLM output
model RecommendationLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  inputSnapshot Json // sanitized inputs used for generation (no raw prompts/PHI leakage)
  outputSnapshot Json // final formatted output shown to user
  safetyEnginePassed Boolean
  ruleEnginePassed   Boolean
  validationPassed   Boolean
  latencyMs    Int?
  modelProvider AIProvider?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("recommendation_logs")
}

model AIUsage {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @db.Uuid
  provider      AIProvider
  operation     String // e.g. "meal_recommendation", "ocr_extraction", "chat"
  promptTokens  Int?
  completionTokens Int?
  costUsd       Float?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([operation])
  @@map("ai_usage")
}

model ModelConfiguration {
  id           String     @id @default(uuid()) @db.Uuid
  provider     AIProvider
  modelName    String
  purpose      String // e.g. "chat", "embedding", "ocr"
  isDefault    Boolean    @default(false)
  temperature  Float?     @default(0.3)
  maxTokens    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([provider, modelName, purpose])
  @@map("model_configurations")
}

// ============================================================
// ADMINISTRATION DOMAIN — Sec. 44
// Owner: Admin Module
// Responsibilities: Administration, Monitoring, Analytics
// ============================================================

model Admin {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @unique @db.Uuid
  title  String? // e.g. "Support Lead"

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("admins")
}

// Sec. 63 Audit Logging — old value, new value, timestamp, user, module
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  module    String
  entityName String
  entityId  String   @db.Uuid
  action    String // CREATE | UPDATE | DELETE | SOFT_DELETE
  oldValue  Json?
  newValue  Json?
  performedBy String? @db.Uuid
  reason    String?

  createdAt DateTime @default(now())

  @@index([entityName, entityId])
  @@index([performedBy])
  @@map("audit_logs")
}

model SystemSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model FeatureFlag {
  id         String            @id @default(uuid()) @db.Uuid
  key        String            @unique
  status     FeatureFlagStatus @default(DISABLED)
  rolloutPct Int?              @default(0)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

model PermissionLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  permissionCode String
  granted    Boolean
  performedBy String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("permission_logs")
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  service   String // api | ai | ocr | queue | database
  message   String   @db.Text
  stackTrace String? @db.Text
  severity  Severity @default(MEDIUM)
  resolved  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([service, createdAt])
  @@index([severity])
  @@map("error_logs")
}

model Analytics {
  id       String @id @default(uuid()) @db.Uuid
  metric   String
  value    Float
  dimensions Json?
  recordedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([metric, recordedAt])
  @@map("analytics")
}

model NotificationQueue {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus  @default(QUEUED)
  scheduledFor DateTime?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("notification_queue")
}

model Announcement {
  id        String        @id @default(uuid()) @db.Uuid
  title     String
  body      String        @db.Text
  status    ContentStatus @default(DRAFT)
  publishAt DateTime?
  expireAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("announcements")
}

model SupportTicket {
  id       String               @id @default(uuid()) @db.Uuid
  userId   String               @db.Uuid
  subject  String
  description String            @db.Text
  status   SupportTicketStatus  @default(OPEN)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("support_tickets")
}

// ============================================================
// MASTER / LOOKUP TABLES — Sec. 49
// Seeded during installation (Sec. 27/65). Never business data, never duplicated.
// ============================================================

model Country {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  isoCode String @unique // ISO 3166-1 alpha-2

  states State[]
  userProfiles UserProfile[]
  addresses Address[]
  regionalFoods RegionalFood[]

  createdAt DateTime @default(now())

  @@map("countries")
}

model State {
  id        String  @id @default(uuid()) @db.Uuid
  countryId String  @db.Uuid
  name      String

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]
  userProfiles UserProfile[]
  addresses Address[]

  createdAt DateTime @default(now())

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id      String @id @default(uuid()) @db.Uuid
  stateId String @db.Uuid
  name    String

  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)
  userProfiles UserProfile[]
  addresses Address[]
  stores Store[]
  healthyRestaurants HealthyRestaurant[]

  createdAt DateTime @default(now())

  @@unique([stateId, name])
  @@map("cities")
}

model Language {
  id     String @id @default(uuid()) @db.Uuid
  name   String @unique
  code   String @unique // ISO 639-1

  primaryFor   LanguagePreference[] @relation("PrimaryLanguage")
  secondaryFor LanguagePreference[] @relation("SecondaryLanguage")

  createdAt DateTime @default(now())

  @@map("languages")
}

model Religion {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  userProfiles UserProfile[]

  createdAt DateTime @default(now())

  @@map("religions")
}

model SubscriptionPlan {
  id            String               @id @default(uuid()) @db.Uuid
  type          SubscriptionPlanType @unique
  name          String
  priceUsd      Float
  billingPeriod String // monthly | yearly | lifetime
  features      Json?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

// ============================================================
// HEALTH MONITORING DOMAIN — Phase 3 Extension
// Support logging/tracking: Blood Glucose, HbA1c, Blood Pressure, Weight
// ============================================================

enum HealthMetricType {
  BLOOD_GLUCOSE
  HBA1C
  BLOOD_PRESSURE
  WEIGHT
}

enum GlucoseContext {
  FASTING
  POST_MEAL
  RANDOM
  BEDTIME
  GENERAL
}

model HealthReading {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  metricType     HealthMetricType
  value          Float            // primary numeric value (mg/dL, %, mmHg systolic, kg)
  secondaryValue Float?           // e.g., mmHg diastolic for blood pressure
  unit           String           // mg/dL, %, mmHg, kg
  context        GlucoseContext?  // FASTING, POST_MEAL, RANDOM, BEDTIME, GENERAL
  notes          String?
  recordedAt     DateTime         @default(now())
  source         TrackingSource   @default(MANUAL)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, metricType, recordedAt])
  @@map("health_readings")
}

