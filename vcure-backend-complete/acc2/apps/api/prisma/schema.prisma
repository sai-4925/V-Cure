  @@map("recipe_videos")
}

model RecipeNutrition {
  id           String @id @default(uuid()) @db.Uuid
  recipeId     String @unique @db.Uuid
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float?
  perServing   Boolean @default(true)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

