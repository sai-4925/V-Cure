// ============================================================
// RECOMMENDATION DOMAIN — Sec. 39
// Owner: Recommendation Module
// Responsibilities: Personalized Recommendations, Safety Validation, Recommendation History
// Business Rule (Sec. 55): valid only if Health+Medical+Lifestyle complete AND Safety Engine approves.
// ============================================================

model MealPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  date      DateTime @db.Date
  isActive  Boolean  @default(true)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  meals Meal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, date])
  @@index([userId, date])
  @@map("meal_plans")
}

model Meal {
  id         String   @id @default(uuid()) @db.Uuid
  mealPlanId String   @db.Uuid
  recipeId   String?  @db.Uuid
  mealType   MealType
  scheduledAt DateTime?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  recommendation   MealRecommendation?
  alternatives     MealAlternative[]
  restrictions     MealRestriction[]
  mealTracking     MealTracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mealPlanId])
  @@index([mealType])
  @@map("meals")
}

// Sec. 50 AI Explainability Policy — every recommendation must answer why/why-not/nutrients/benefit
model MealRecommendation {
  id         String   @id @default(uuid()) @db.Uuid
  mealId     String   @unique @db.Uuid
  confidenceScoreId String? @unique @db.Uuid
  safetyValidationId String @db.Uuid
  generatedByModel String? // model/version identifier, never expose internal prompt (Sec. Security)
  status     RecommendationStatus @default(GENERATED)

  meal             Meal              @relation(fields: [mealId], references: [id], onDelete: Cascade)
  confidenceScore  ConfidenceScore?  @relation(fields: [confidenceScoreId], references: [id], onDelete: SetNull)
  safetyValidation SafetyValidation  @relation(fields: [safetyValidationId], references: [id], onDelete: Restrict)
  reasons          MealReason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("meal_recommendations")
}

model MealReason {
  id                   String @id @default(uuid()) @db.Uuid
  mealRecommendationId String @db.Uuid
  reasonText           String @db.Text // human-readable explanation — never "because I think so" (Sec. 50)
  nutrientFocus        String?

  mealRecommendation MealRecommendation @relation(fields: [mealRecommendationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mealRecommendationId])
  @@map("meal_reasons")
}

model MealAlternative {
  id            String @id @default(uuid()) @db.Uuid
  mealId        String @db.Uuid
  alternativeRecipeId String @db.Uuid
  reason        String?

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mealId])
  @@map("meal_alternatives")
}

model MealRestriction {
  id      String              @id @default(uuid()) @db.Uuid
  mealId  String              @db.Uuid
  type    FoodRestrictionType
  reason  String

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mealId])
  @@map("meal_restrictions")
}

// History Table — Sec. 48 Recommendation History
model RecommendationHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  payload   Json // full snapshot of the recommendation as delivered
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, generatedAt])
  @@map("recommendation_history")
}

// Sec. 51 User Feedback Loop
model RecommendationFeedback {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  mealId    String          @db.Uuid
  feedback  FeedbackType
  reason    FeedbackReason?
  comment   String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([mealId])
  @@map("recommendation_feedback")
}

// Sec. 54 Healthcare Safety Rules enforced here — every AI output passes Safety Engine before Rule Engine
model SafetyValidation {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @db.Uuid
  result        SafetyValidationResult
  blockedReason String?
  checkedAllergies Boolean @default(true)
  checkedMedicines Boolean @default(true)
  checkedConditions Boolean @default(true)

  mealRecommendations MealRecommendation[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([result])
  @@map("safety_validations")
}

model ConfidenceScore {
  id     String @id @default(uuid()) @db.Uuid
  score  Float // 0.0 - 1.0
  basis  Json? // factors contributing to the score

  mealRecommendation MealRecommendation?

  createdAt DateTime @default(now())

  @@map("confidence_scores")
}

